{
  "metadata": {
    "version": "1.0",
    "last_updated": "2026-11-19",
    "note": "Domain cards the engine can run as player abilities. Keys are card names from the embedded domain data; effects use the feature mapping schema, with target_type self/ally/allies for heals and stress clears. Approximations are spelled out in note. proficiency_dice rolls the caster's Proficiency in dice of the formula's size."
  },
  "mappings": {
    "Healing Hands": {
      "stress_cost": 1,
      "dc_type": "fixed",
      "fixed_dc": 13,
      "max_uses": 1,
      "refresh_type": "scene",
      "note": "SRD: a failure still clears 1, and the same target can't be healed again until a long rest. Modelled as success-only, once per combat.",
      "effects": [
        {
          "category": "FeatureEffectHPHeal",
          "magnitude": 2,
          "target_type": "ally",
          "description": "Clear 2 Hit Points on the most wounded ally"
        }
      ]
    },
    "Healing Field": {
      "max_uses": 1,
      "refresh_type": "long_rest",
      "note": "The 2 Hope upgrade to 2 Hit Points is not modelled.",
      "effects": [
        {
          "category": "FeatureEffectHPHeal",
          "magnitude": 1,
          "target_type": "allies",
          "description": "You and all allies clear a Hit Point"
        }
      ]
    },
    "Healing Strike": {
      "passive": true,
      "trigger": "on_hit",
      "hope_cost": 2,
      "note": "Fires on a successful basic attack; only fires when an ally is wounded.",
      "effects": [
        {
          "category": "FeatureEffectHPHeal",
          "magnitude": 1,
          "target_type": "ally",
          "description": "Spend 2 Hope to clear a Hit Point on an ally"
        }
      ]
    },
    "Second Wind": {
      "passive": true,
      "trigger": "on_hit",
      "max_uses": 1,
